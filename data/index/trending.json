    {
      "id": "bs-did%3Aplc%3As42iw2fbfmgsgh7hdtvvoaao%2Fapp.bsky.feed.post%2F3mxk3md54vc2a",
      "source": "bluesky",
      "published_at": "2026-10-10T18:11:24Z",
      "title": "Why focusing on cap $ can be misleading.",
      "url": "https://bsky.app/profile/hoopinformatics.com/post/3mxk3md54vc2a",
      "author": "Hoop Informatics",
      "thumbnail": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:s42iw2fbfmgsgh7hdtvvoaao/bafkreifh3wbjfvcbhiritjpre55vzjmqiqdhsa6o5kbp4mqcx6v2qbqvzi",
      "body_excerpt": "Why focusing on cap $ can be misleading.\n\nYou are conditioned to compare new salaries to past salaries. But the cap keeps rising distorting those comparisons.\n\nBrandin Podziemski signed a 5yr, $110m extension. That same extension starting in 2019-20 season would be 5yr, $67m.",
      "players": [],
      "teams": [],
      "media": {
        "type": "image",
        "images": [
          {
            "url": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:s42iw2fbfmgsgh7hdtvvoaao/bafkreifh3wbjfvcbhiritjpre55vzjmqiqdhsa6o5kbp4mqcx6v2qbqvzi",
            "alt": "Dumbbell chart titled \"Brandin Podziemski Contract Extension Compared to If It Started in the 2019-20 Season.\" For each year of the five-year deal, a gray dot shows the salary at that year's cap percentage applied to a 2019-24 salary cap, and a blue dot shows the projected 2027-32 salary at the same percentage. Year 1, 10.8% of cap: $11.8M at the 2019-20 cap versus $18.9M in 2027-28. Year 2, 11.1%: $12.1M at the 2020-21 cap versus $20.5M in 2028-29. Year 3, 11.3%: $12.7M at the 2021-22 cap versus $22.0M in 2029-30. Year 4, 11.5%: $14.2M at the 2022-23 cap versus $23.5M in 2030-31. Year 5, 11.7%: $15.9M at the 2023-24 cap versus $25.0M in 2031-32. Data: Keith Smith, Spotrac. Viz: @Hoopinformatics.com on Bluesky."
          }
        ]
      },
