      "id": "bs-did%3Aplc%3Ay3xahfdgzxpjsqogokmi43bt%2Fapp.bsky.feed.post%2F3n3b4wvor2c26",
      "source": "bluesky",
      "published_at": "2026-11-27T02:22:02Z",
      "title": "Canada has qualified for the 2027 FIBA Men's World Cup.",
      "url": "https://bsky.app/profile/blakemurphy.bsky.social/post/3n3b4wvor2c26",
      "author": "Blake Murphy",
      "thumbnail": null,
      "body_excerpt": "Canada has qualified for the 2027 FIBA Men's World Cup.\n\nBahamas lose to Argentina, and now even the most bizarre tiebreaker scenarios are off the table.\n\n3 qualifying window games to go for Canada, but they're in.",
      "players": [],
      "teams": [],
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:y3xahfdgzxpjsqogokmi43bt/bafkreiaqlur4c4jaie7c6dico5vncvaskkiphyhpkqzwuco5praatpfzve",
      "quote": {
        "author": "Blake Murphy",
        "handle": "blakemurphy.bsky.social",
        "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:y3xahfdgzxpjsqogokmi43bt/bafkreiaqlur4c4jaie7c6dico5vncvaskkiphyhpkqzwuco5praatpfzve",
        "text": "Canada has its first loss in 2027 FIBA Men's World Cup qualifying.\n\nA big late comeback falls short vs Uruguay, for an 84-78 loss.\n\nCanada now 8-1 (+152) and can still qualify with 1 win or Bahamas loss.\n\nBack at it Sunday.",
        "url": "https://bsky.app/profile/blakemurphy.bsky.social/post/3n3avu7ayw22h"
      },
      "enriched": true,
      "trending_score": 0.1388
    },
