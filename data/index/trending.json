    {
      "id": "bs-did%3Aplc%3Ae3ktrbooe3mildj4hhwhsvtc%2Fapp.bsky.feed.post%2F3n2mcrbf4vs2s",
      "source": "bluesky",
      "published_at": "2026-11-18T19:40:21Z",
      "title": "Update: The Chicago Bulls signed Orlando Robinson to a two-year, $5.25 million deal, which is non-guaranteed for this 2026-27 season and includes a team option for the 2027-28 season, league sources said.",
      "url": "https://bsky.app/profile/mikeascotto.bsky.social/post/3n2mcrbf4vs2s",
      "author": "Michael Scotto",
      "thumbnail": null,
      "body_excerpt": "Update: The Chicago Bulls signed Orlando Robinson to a two-year, $5.25 million deal, which is non-guaranteed for this 2026-27 season and includes a team option for the 2027-28 season, league sources said.",
      "players": [],
      "teams": [
        "chicago-bulls"
      ],
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:e3ktrbooe3mildj4hhwhsvtc/bafkreiegqo54izmuc42h4iy5zzmdw4gvwbtwiayjruoqxy3tifeofydl2q",
      "quote": {
        "author": "Michael Scotto",
        "handle": "mikeascotto.bsky.social",
